{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aividi/core": ["./packages/core/src/index.ts"],
      "@aividi/core/*": ["./packages/core/src/*"],
      "@aividi/db": ["./packages/db/src/index.ts"],
      "@aividi/db/*": ["./packages/db/src/*"],
      "@aividi/pipeline": ["./packages/pipeline/src/index.ts"],
      "@aividi/pipeline/queue": ["./packages/pipeline/src/queue.ts"]
    }
  }
}
