# --- database -------------------------------------------------------------
# Needs PostGIS + pg_trgm. `docker compose up -d` gives you both.
DATABASE_URL=postgres://aividi:aividi@localhost:5432/aividi

# --- queue ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- admin ----------------------------------------------------------------
# Single shared password for the internal admin. Change it before deploying.
ADMIN_PASSWORD=promeni-me
# Used to sign the admin session cookie. Any long random string.
ADMIN_SECRET=generate-a-long-random-string-here

# --- ingestion ------------------------------------------------------------
# Overpass is free and needs no key. Be polite: one city at a time.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Google Places is DISCOVERY ONLY - we persist place_id and nothing else.
# See packages/../apps/worker/src/sources/places.ts for why.
GOOGLE_PLACES_API_KEY=

# --- pilot ----------------------------------------------------------------
PILOT_PLACE_SLUG=strumica

# The public origin of THIS deployment. Canonicals, Open Graph URLs and the
# sitemap are all built from it, so it must match the domain people reach.
SITE_URL=https://aividi.mk

# Indexing is opt-in per deployment. Preview hosts (vercel.app, onrender.com,
# railway.app, fly.dev, localhost) are refused automatically; set this to 1 to
# force indexing on, or 0 to force it off. A staging copy that gets indexed
# competes with the real site for the exact queries we are trying to own.
SITE_INDEXABLE=1
