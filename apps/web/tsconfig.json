{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "types": ["node", "react"],
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@aividi/core": ["../../packages/core/src/index.ts"],
      "@aividi/db": ["../../packages/db/src/index.ts"],
      "@aividi/pipeline": ["../../packages/pipeline/src/index.ts"],
      "@aividi/pipeline/queue": ["../../packages/pipeline/src/queue.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
